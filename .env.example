# Copy this file to .env and fill in the values.
#
# Any OpenAI-compatible endpoint works. Examples:
#   OpenAI:   COOPER_BASE_URL=https://api.openai.com/v1   COOPER_MODEL=gpt-4o-mini
#   DeepSeek: COOPER_BASE_URL=https://api.deepseek.com    COOPER_MODEL=deepseek-chat
#   Moonshot: COOPER_BASE_URL=https://api.moonshot.cn/v1  COOPER_MODEL=kimi-k2-0711-preview
#
# COOPER_API_KEY falls back to OPENAI_API_KEY if unset.

COOPER_API_KEY=
COOPER_BASE_URL=https://api.openai.com/v1
COOPER_MODEL=gpt-4o-mini

# Approval mode: ask (default) | auto (allow everything) | plan (read-only)
# COOPER_MODE=ask

# Context budget. Unknown models are assumed to have a 200k window; override
# this if you know better. Cooper prunes old tool output at 65% of the usable
# budget, summarizes at 80%, and force-truncates at 92%.
# COOPER_CONTEXT_WINDOW=200000
# COOPER_CONTEXT_RESERVE=16384
# COOPER_CONTEXT_COMPACT=on
# COOPER_SUMMARY_MODEL=

# Show the model's reasoning summary (display-only; never stored in history)
# COOPER_SHOW_REASONING=0
