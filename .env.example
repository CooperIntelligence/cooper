# Copy this file to .env and fill in the values.
#
# Protocol: openai (default, any OpenAI-compatible endpoint) or anthropic.
# COOPER_PROVIDER=openai
#
# OpenAI-compatible examples:
#   OpenAI:   COOPER_BASE_URL=https://api.openai.com/v1   COOPER_MODEL=gpt-6-astra
#   DeepSeek: COOPER_BASE_URL=https://api.deepseek.com    COOPER_MODEL=deepseek-flash
#   Moonshot: COOPER_BASE_URL=https://api.moonshot.cn/v1  COOPER_MODEL=kimi-k3.1-pro
#
# Anthropic native:
#   COOPER_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=...
#   COOPER_MODEL=claude-opus-5-5
#   ANTHROPIC_BASE_URL=...            # optional
#
# COOPER_API_KEY falls back to OPENAI_API_KEY or ANTHROPIC_API_KEY.

# Leave MODEL/BASE_URL unset to use the selected provider's defaults
# (gpt-4o-mini / https://api.openai.com/v1, or claude-opus-5-5).
COOPER_API_KEY=
# COOPER_BASE_URL=https://api.openai.com/v1
# COOPER_MODEL=gpt-4o-mini

# Anthropic max_tokens (streaming keeps a high ceiling safe)
# COOPER_MAX_OUTPUT_TOKENS=64000

# Approval mode: ask (default) | auto (allow everything) | plan (read-only)
# COOPER_MODE=ask

# Context budget. Unknown models are assumed to have a 200k window; override
# this if you know better. Cooper prunes old tool output at 65% of the usable
# budget, summarizes at 80%, and force-truncates at 92%.
# COOPER_CONTEXT_WINDOW=200000
# COOPER_CONTEXT_RESERVE=16384
# COOPER_CONTEXT_COMPACT=on
# COOPER_SUMMARY_MODEL=

# Show the model's reasoning summary (display-only; never stored in history)
# COOPER_SHOW_REASONING=0

# Cooper data directory (default: ~/.cooper). Sessions live under
# projects/<workspace-key>/sessions/ and can be continued with --resume <id>.
# COOPER_HOME=
